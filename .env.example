# Google Gemini API Key
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional extra video providers. ADA does not claim success without a real provider response.
# RUNWAYML_API_KEY=your_runway_key
# INVIDEO_API_KEY=your_invideo_key
# VEO_API_KEY=your_veo_key

# Optional Canva design link. The presentation, flyer, or document is still saved locally.
# CANVA_ACCESS_TOKEN=your_canva_token

# Optional social posting. YouTube and TikTok stay private unless you change the privacy values.
# FACEBOOK_PAGE_ID=your_page_id
# FACEBOOK_PAGE_ACCESS_TOKEN=your_page_token
# INSTAGRAM_USER_ID=your_instagram_user_id
# INSTAGRAM_ACCESS_TOKEN=your_instagram_token
# TIKTOK_ACCESS_TOKEN=your_tiktok_token
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# YOUTUBE_ACCESS_TOKEN=your_youtube_token
# YOUTUBE_PRIVACY=private
