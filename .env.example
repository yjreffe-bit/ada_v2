# Google Gemini API Key
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional extra video providers. ADA does not claim success without a real provider response.
# RUNWAYML_API_KEY=your_runway_key
# INVIDEO_API_KEY=your_invideo_key
# VEO_API_KEY=your_veo_key

# Optional Connect overrides. Prefer Settings → Connections, which stores the id and secret
# on this PC. Anything set here overrides the panel. YouTube's Client ID and Meta's App ID
# are already filled in there. Never put a client secret in this example.
# The panel shows the exact redirect URL and a Copy button.
# Full steps: docs/CONNECT_ACCOUNTS.md
# Canva:    http://127.0.0.1:8000/oauth/canva/callback
# YouTube:  http://127.0.0.1:8000/oauth/youtube/callback
# Meta:     http://127.0.0.1:8000/oauth/meta/callback
# TikTok:   http://127.0.0.1:8000/oauth/tiktok/callback
# If ADA_PORT is not 8000, the panel URL changes and that is the one to register.
# CANVA_CLIENT_ID=your_canva_client_id
# CANVA_CLIENT_SECRET=your_canva_client_secret
# GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
# META_APP_ID=your_meta_app_id
# META_APP_SECRET=your_meta_app_secret
# TIKTOK_CLIENT_KEY=your_tiktok_client_key
# TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Optional manual tokens. When set, they override the saved Connect login.
# CANVA_ACCESS_TOKEN=your_canva_token
# YOUTUBE_ACCESS_TOKEN=your_youtube_token
# YOUTUBE_PRIVACY=private
# FACEBOOK_PAGE_ID=your_page_id
# FACEBOOK_PAGE_ACCESS_TOKEN=your_page_token
# INSTAGRAM_USER_ID=your_instagram_user_id
# INSTAGRAM_ACCESS_TOKEN=your_instagram_token
# TIKTOK_ACCESS_TOKEN=your_tiktok_token
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY
